# Copy to .env and adjust. .env is gitignored; only this example is committed.

# --- database ---------------------------------------------------------------
POSTGRES_USER=automotrix
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=automotrix
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
# Used by the loader, sqlx-cli and `cargo run` on the host. Inside Docker the app
# gets its own DATABASE_URL pointing at the `db` service instead.
DATABASE_URL=postgres://automotrix:change_me_locally@localhost:5432/automotrix

# --- AI ---------------------------------------------------------------------
# Get a key at https://console.anthropic.com. The chat answers with a setup
# message until this is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- email ------------------------------------------------------------------
# smtp -> Mailpit locally (see http://localhost:8025); nothing leaves the machine
# http -> Postmark, for production
# unset -> held in memory and logged
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
POSTMARK_TOKEN=
EMAIL_FROM="Automotrix Bot <bot@automotrix-demo.com>"

# --- web chat ---------------------------------------------------------------
HTTPS_PORT=8443
# This machine's LAN IP, so the certificate covers it and a phone on the same
# Wi-Fi can open the chat. Leave empty for localhost only.
PUBLIC_HOSTNAME=
PUBLIC_BASE_URL=https://localhost:8443
